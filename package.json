{
  "name": "visakh-vijayan-playwright-ts",
  "version": "1.0.0",
  "description": "Playwright TypeScript test automation framework for Visakh Vijayan",
  "scripts": {
    "test": "playwright test --config=config/playwright.config.ts",
    "test:headed": "HEADLESS=false playwright test --config=config/playwright.config.ts",
    "test:ui": "playwright test --config=config/playwright.config.ts --ui",
    "test:debug": "playwright test --config=config/playwright.config.ts --debug",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.7.0",
    "winston": "^3.17.0"
  }
}
